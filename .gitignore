# Secrets: only the template is committed
.env
.env.*
*.env
!.env.example

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage

# Node and frontend build output
node_modules/
frontend/dist/
*.tsbuildinfo

# Playwright output, test accounts and local QA runs
frontend/test-results/
frontend/playwright-report/
frontend/e2e/.auth/
/qa-out/

# Datasets that stay local: raw downloads (may hold real people's data), external
# datasets (their own licences), bulk synthetic output and evaluation rounds.
# Regenerate them with the tools in training/ and evalkit/.
data/raw/
/data/synthetic/*
!/data/synthetic/pdfs/
/data/external/
/data/rounds/
/evalkit/runs/
# Runtime locks for the committed training-call journals
/data/results/**/.sender.lock

# Local tool state and editors
.local/
.DS_Store
.idea/
.vscode/

