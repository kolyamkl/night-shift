{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "veil-backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "backend", "--env-file", "../.env", "uvicorn", "app.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "veil-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "veil-backend-demo",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "backend", "--env-file", "../.env", "uvicorn", "app.main:app", "--port", "8002"],
      "port": 8002
    },
    {
      "name": "veil-mock",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "MOCK_ERROR=none MOCK_BACKEND=${VEIL_DEMO_BACKEND:-http://127.0.0.1:8002} node frontend/scripts/mock-stream.mjs"],
      "port": 8010
    },
    {
      "name": "veil-frontend-demo",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd frontend && VEIL_API=${VEIL_DEMO_API:-http://127.0.0.1:8010} npx vite --port 5174 --strictPort"],
      "port": 5174
    }
  ]
}
