# Copy to .env (git-ignored) and fill in. scripts/dataset/send_batch.py reads it
# when MUBIT_API_KEY is not already set in the environment.

# Mubit key of type "Inference" from app.mubit.ai, for the project that should own
# the T1 task. Starts with mbt_. Never put a provider (Anthropic, OpenAI) key here.
MUBIT_API_KEY=

# scripts/local_db.py start configures these in your ignored .env.
# Keep the encryption key when restarting: changing it makes existing data unreadable.
# Leave blank for local_db.py to generate a URL with the local password.
DATABASE_URL=
VEIL_STORAGE_KEY=
# Set true when serving the app over HTTPS. Local HTTP development uses false.
VEIL_COOKIE_SECURE=false

# Veil backend T1 prompt: rewrite (default: backend/app/llm/prompts.py on claude-haiku-4-5, Mubit task "Redact personal data")
# or evalkit (the evalkit prompt on gpt-6-luna, task "Find personal data").
VEIL_T1_PROMPT=rewrite
